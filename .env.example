ENV=development
APP_NAME="MeshCards Studio"

# --- AI Providers ---
# Leave empty if you want users to bring their own keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NOVITA_API_KEY=

# --- Access Control Settings ---
# NOVITA_ACCESS_MODE: "all" = everyone can use Novita, "sponsors_only" = only sponsors
NOVITA_ACCESS_MODE=sponsors_only

# GEMINI_MODE: "shared" = use system key (with quotas), "byok" = users must provide own key
GEMINI_MODE=shared

# --- Rate Limiting ---
# Protects against API abuse (per IP address)
RATE_LIMIT_FREE="2/hour"

# --- Supabase Configuration ---
# Frontend auth must use the anon key.
# Backend server tasks must use the service-role key.
# For local development, use: npx supabase start
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key-here

# --- GitHub Feedback Integration (Optional) ---
# Create token at: https://github.com/settings/tokens
# Required scope: repo
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=username/repository
