ENV=development
APP_NAME="MeshCards Studio"

# --- AI Providers ---
# Leave empty if you want users to bring their own keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NOVITA_API_KEY=

# --- Rate Limiting ---
# Protects against API abuse (per IP address)
RATE_LIMIT_FREE="2/hour"

# --- Supabase Configuration (Required for Quotas & Auth) ---
# Get these from Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here

# --- GitHub Feedback Integration (Optional) ---
# Create token at: https://github.com/settings/tokens
# Required scope: repo
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=username/repository
