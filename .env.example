ENV=development
APP_NAME="MeshCards Studio"

# --- AI Providers ---
# Leave empty if you want users to bring their own keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Rate Limiting ---
RATE_LIMIT_FREE="10/minute"

# --- Supabase Configuration (Required for Quotas & Auth) ---
# Get these from Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key-here
